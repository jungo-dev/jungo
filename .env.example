API_SERVER_PORT=8080
API_ENVIRONMENT=development
API_VERSION=v0.1.0
API_COMMIT=local
API_LANGUAGE=en
API_TIMEZONE=UTC
API_KEY=dev-secret-api-key

# Visit any endpoint with ?t_debug=0604 to see the tracer debug dashboard.
TRACER_DEBUG_KEY=t_debug
TRACER_DEBUG_VALUE=0604

DB_HOST=postgresql
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_api_framework
DB_SSLMODE=disable
DB_MAX_CONNECTION=25
DB_MIN_CONNECTION=5
DB_QUERY_LOGGING=true

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-API-Key,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

LOG_LEVEL=debug
LOG_FILENAME=storage/logs/app.log

LIMITER_RPS=10
LIMITER_BURST=30

SECURITY_MAX_BODY_SIZE=2097152

# Cache is off by default — the base stack never requires Redis.
# Set CACHE_ENABLED=true and start with `make app-dev WITH=cache` to enable it.
CACHE_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_BASE_DIR=./storage/uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

# Telegram alerting is off by default (empty token/chat id are safe no-ops).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recaptcha defaults to mock verification (always succeeds) outside production.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MOCK=true
