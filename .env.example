APP_NAME=jungo
API_SERVER_PORT=8080
API_ENVIRONMENT=development
API_VERSION=v0.1.0
API_COMMIT=local
API_LANGUAGE=en
API_TIMEZONE=UTC

# Auth keys are generated by `make app-init`. Changing a token key logs every user out.
AUTH_TOKEN_HMAC_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_INTERNAL_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_CACHE_TTL=3m
AUTH_REVOKED_RETENTION=168h
AUTH_PASSWORD_COST=12
AUTH_RECAPTCHA_ON_LOGIN=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_BLOCK_WINDOW=15m
AUTH_LOGIN_BLACKLIST_ATTEMPTS=8
AUTH_LOGIN_BLACKLIST_WINDOW=24h
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=10

# App container CPU/memory caps
# APP_MEM_LIMIT=1024M
# APP_CPU_LIMIT=1.0
# APP_GOMEMLIMIT=900MiB

# Visit any endpoint with ?t_debug=0604 to see the tracer debug dashboard.
TRACER_DEBUG_KEY=t_debug
TRACER_DEBUG_VALUE=0604

DB_HOST=postgresql
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jungo
DB_SSLMODE=disable
DB_MAX_CONNECTION=25
DB_MIN_CONNECTION=5
DB_QUERY_LOGGING=true

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Device-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

LOG_APP_LEVEL=debug
LOG_APP_FILENAME=storage/logs/app.log

LIMITER_RPS=10
LIMITER_BURST=30

SECURITY_MAX_BODY_SIZE=2097152

# Enable with CACHE_ENABLED=true + `make app-dev WITH=cache`.
CACHE_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_BASE_DIR=./storage/uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

# Telegram alerting is off by default (empty token/chat id are safe no-ops).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recaptcha defaults to mock verification (always succeeds) outside production.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MOCK=true
